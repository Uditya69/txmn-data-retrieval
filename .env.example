# Milvus
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=root:Milvus
MILVUS_DB=aic

# Elasticsearch
ES_URI=http://localhost:9200
ES_USERNAME=
ES_PASSWORD=
ES_INDEX=taxmann_caselaw
ES_VERIFY_CERTS=true

# Feature flags (AI Mode / Instant mode)
AI_MODE_RERANK_ENABLED=true
INSTANT_MODE_RERANK_ENABLED=false
INSTANT_MODE_RRF_ENABLED=true
MILVUS_SPARSE_ENABLED=false
KEYWORD_MODE_EXPANSION_ENABLED=false

# model-gateway: providers/models
DEEPINFRA_API_KEY=
DEEPINFRA_CHAT_MODEL_SLM=google/gemma-4-26B-A4B-it
DEEPINFRA_CHAT_MODEL_SYNTHESIS=meta-llama/Meta-Llama-3.1-70B-Instruct
DEEPINFRA_RERANK_MODEL=Qwen/Qwen3-Reranker-0.6B
VOYAGE_API_KEY=
VOYAGE_EMBED_MODEL=voyage-4-large

# model-gateway: provider switches
CHAT_PROVIDER=deepinfra  # deepinfra | local
RERANK_PROVIDER=deepinfra  # deepinfra | local_rerank

# model-gateway: self-hosted chat endpoint (CHAT_PROVIDER=local)
LOCAL_API_KEY=unsecure-api-key-taxmann
LOCAL_BASE_URL=http://192.168.0.15:8000/v1
LOCAL_CHAT_MODEL_SLM=qwen3
LOCAL_CHAT_MODEL_SYNTHESIS=qwen3

# model-gateway: self-hosted reranker (RERANK_PROVIDER=local_rerank)
LOCAL_RERANK_BASE_URL=http://192.168.0.15:8001/v1
LOCAL_RERANK_MODEL=qwen3-reranker

# model-gateway: per-role thinking-mode toggle
SLM_REASONING_ENABLED=true
SYNTHESIS_REASONING_ENABLED=true

# Langfuse
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# auth + persona + chat + semantic_cache (shared Mongo deployment)
MONGO_URI=mongodb://host.docker.internal:27017
MONGO_DB=taxmann_auth
JWT_SECRET=  # generate with: openssl rand -hex 32
JWT_EXPIRY_MINUTES=60

# semantic_cache
SEMANTIC_CACHE_THRESHOLD=0.95
SEMANTIC_CACHE_ENABLED=true

# admin eval-runner UI (/admin) - unset disables it
ADMIN_SECRET=

# Dev-only: include synthesis reasoning in the ai_mode_done websocket message
EXPOSE_REASONING=false

# evals/hot_query_smoke_test.py only - live prod API auth (never commit real values)
PROD_API_TOKEN=
PROD_MACHINE_ID=
