# Milvus
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=root:Milvus
MILVUS_DB=aic

# Elasticsearch
ES_URI=http://localhost:9200
ES_USERNAME=
ES_PASSWORD=
ES_INDEX=taxmann_caselaw
ES_VERIFY_CERTS=true

# model-gateway
GATEWAY_URL=http://model-gateway:8001
# A/B switch: set false to skip AI Mode's DeepInfra reranker step (falls back to
# top-5-by-rrf_score) - toggle to compare AI Mode quality with/without reranking.
AI_MODE_RERANK_ENABLED=true
# Kill switch for native Milvus sparse (BM25 Function) search - shared by AI Mode's
# retrieve() and Instant mode's own Milvus pass. Off by default - env-only, no UI
# toggle. AI Mode's ES sparse-fallback (for collections with no sparse_vector at
# all) always runs regardless of this flag.
MILVUS_SPARSE_ENABLED=false
DEEPINFRA_API_KEY=
DEEPINFRA_CHAT_MODEL_SLM=google/gemma-4-26B-A4B-it  # confirmed via evals/intent_filter_cases.json prompt-only check: 9/12 vs Qwen3-30B-A3B baseline's 5-8/12 (run-to-run variance observed) - correctly extracts bench, which the baseline never did
DEEPINFRA_CHAT_MODEL_SYNTHESIS=meta-llama/Meta-Llama-3.1-70B-Instruct  # no confirmed self-hostable replacement yet - see docs/small-model-eval-results.md
# DEEPINFRA_RERANK_MODEL=Qwen/Qwen3-Reranker-4B  # pre-small-model-eval default
DEEPINFRA_RERANK_MODEL=Qwen/Qwen3-Reranker-0.6B  # confirmed via docs/small-model-eval-results.md: mild dip, one query (Q47) worth a spot-check
VOYAGE_API_KEY=
VOYAGE_EMBED_MODEL=voyage-4-large

# Switches slm+synthesis between DeepInfra and the self-hosted adapter below. Both roles
# moved to "local" together, so this one switch flips both back in lockstep.
CHAT_PROVIDER=deepinfra  # deepinfra | local

# Self-hosted OpenAI-compatible chat endpoint (e.g. vLLM), used for slm + synthesis roles
# when CHAT_PROVIDER=local.
# NOTE: slm role's model MUST support response_format: {"type": "json_object"}
# (intent.py sends it unconditionally, with no fallback) - verify against this server before relying on it.
LOCAL_API_KEY=unsecure-api-key-taxmann
LOCAL_BASE_URL=http://192.168.0.15:8000/v1
LOCAL_CHAT_MODEL_SLM=qwen3
LOCAL_CHAT_MODEL_SYNTHESIS=qwen3

# Langfuse
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# auth + persona + chat + semantic_cache (packages/auth, packages/persona,
# packages/chat, packages/semantic_cache) - Mongo runs in apps/infra's
# docker-compose, not this repo's; reachable from these containers the same
# way Langfuse is, below. All four packages share this same Mongo
# deployment/db, each in its own collection ("personas", "conversations",
# "semantic_cache").
MONGO_URI=mongodb://host.docker.internal:27017
MONGO_DB=taxmann_auth
JWT_SECRET=  # generate with: openssl rand -hex 32
JWT_EXPIRY_MINUTES=60

# semantic_cache (packages/semantic_cache) - cosine-similarity threshold for
# a cache hit against the Atlas Vector Search index below. Optional, defaults
# to 0.95 if unset.
SEMANTIC_CACHE_THRESHOLD=0.95

# semantic_cache (packages/semantic_cache) - set to false to turn off caching
# entirely: no query embedding is stored, no response is written to or read
# from the semantic_cache collection. Optional, defaults to true if unset.
SEMANTIC_CACHE_ENABLED=true

# Local-only admin eval-runner UI (retrieval_api/admin_eval/) - unset disables the
# feature entirely. Set to any secret string to enable /admin locally.
ADMIN_SECRET=

# Dev-only: set true to include AI Mode's synthesis-step model reasoning in the
# ai_mode_done websocket message sent to clients. Leave false in production.
EXPOSE_REASONING=false
