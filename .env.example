# =============================================================================
# TIER 1 - REQUIRED: pydantic-settings has no default for these, so the
# service crashes at startup (Settings() construction) if any is missing.
# This includes the LOCAL_* self-hosted chat fields even if CHAT_PROVIDER
# below is "deepinfra" - they have no code default, so pydantic still
# demands a value regardless of whether that code path is ever exercised.
# =============================================================================

# Milvus
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=root:Milvus

# Elasticsearch
ES_URI=http://localhost:9200

# model-gateway: DeepInfra + Voyage credentials/models
DEEPINFRA_API_KEY=
DEEPINFRA_CHAT_MODEL_SLM=google/gemma-4-26B-A4B-it
DEEPINFRA_CHAT_MODEL_SYNTHESIS=meta-llama/Meta-Llama-3.1-70B-Instruct
DEEPINFRA_RERANK_MODEL=Qwen/Qwen3-Reranker-0.6B
VOYAGE_API_KEY=
VOYAGE_EMBED_MODEL=voyage-4-large

# model-gateway: self-hosted chat endpoint fields (required regardless of
# CHAT_PROVIDER - see note above)
LOCAL_API_KEY=unsecure-api-key-taxmann
LOCAL_BASE_URL=http://192.168.0.15:8000/v1
LOCAL_CHAT_MODEL_SLM=qwen3
LOCAL_CHAT_MODEL_SYNTHESIS=qwen3

# auth + persona + chat + semantic_cache + admin feature-flags (all share one
# Mongo deployment/database - MONGO_DB is not per-package, every collection
# below lives in the same db)
MONGO_URI=mongodb://host.docker.internal:27017
MONGO_DB=taxmann_auth
JWT_SECRET=  # generate with: openssl rand -hex 32
JWT_EXPIRY_MINUTES=60

# =============================================================================
# TIER 2 - DEPLOYMENT-CRITICAL DEFAULTS: pydantic is happy if these are
# unset, so the service boots and looks healthy - but the value has to
# actually match your target infra or things fail *silently* (wrong/empty
# search results, 401s, TLS errors), not with a startup crash. Verify every
# one of these against the real Milvus/ES/model endpoint you're deploying
# against - never assume the shipped default is correct for your environment.
# =============================================================================

# Unset (None) sends no basic_auth at all - fine for an ES cluster with
# security disabled, but every search 401s if your cluster requires auth.
ES_USERNAME=
ES_PASSWORD=
# False required against a self-signed/internal cert; True (the default)
# rejects that connection outright with a TLS error.
ES_VERIFY_CERTS=true
# Must name the index that actually exists on your ES cluster - a wrong name
# doesn't error, it just returns zero hits for every query.
ES_INDEX=taxmann_caselaw

# Must name the Milvus database that actually exists - same silent-empty-
# results failure mode as ES_INDEX above.
MILVUS_DB=aic

# Decides which of the two blocks above actually gets called for slm/
# synthesis chat: "deepinfra" -> DEEPINFRA_CHAT_MODEL_SLM/SYNTHESIS are live,
# LOCAL_CHAT_MODEL_SLM/SYNTHESIS are dead weight (still required by pydantic,
# never called). "local" flips which pair is live.
CHAT_PROVIDER=deepinfra  # deepinfra | local
# Same idea for the reranker role: "deepinfra" -> DEEPINFRA_RERANK_MODEL is
# live and LOCAL_RERANK_BASE_URL/LOCAL_RERANK_MODEL below are dead weight.
# "local_rerank" flips it.
RERANK_PROVIDER=deepinfra  # deepinfra | local_rerank

# =============================================================================
# TIER 3 - SAFE OPTIONAL: has a code default AND a wrong/missing value only
# ever changes tuning/observability/dev behavior, never causes a silent
# correctness failure the way Tier 2 can.
# =============================================================================

# --- Mongo-overridable feature flags -----------------------------------------
# Toggleable live from /admin -> Flags (Mongo override, no redeploy) once the
# service is running. What's set here only matters as the *initial*/local
# value - an env var set here always wins over a Mongo override permanently
# (see retrieval_api/admin/feature_flags.py's env > Mongo > default order).
AI_MODE_RERANK_ENABLED=true
INSTANT_MODE_AUTO_ROUTE_ENABLED=true
INSTANT_MODE_RERANK_ENABLED=false
INSTANT_MODE_RRF_ENABLED=true
MILVUS_SPARSE_ENABLED=false
KEYWORD_MODE_EXPANSION_ENABLED=false
SLM_REASONING_ENABLED=true
SYNTHESIS_REASONING_ENABLED=true
SEMANTIC_CACHE_ENABLED=true

# --- Self-hosted reranker (only live when RERANK_PROVIDER=local_rerank) -----
LOCAL_RERANK_BASE_URL=http://192.168.0.15:8001/v1
LOCAL_RERANK_MODEL=qwen3-reranker

# --- Tuning knobs (safe defaults, no correctness cliff either way) -----------
SEMANTIC_CACHE_THRESHOLD=0.95
REFRESH_TOKEN_EXPIRY_DAYS=7
# Persona interest-scoring/clustering knobs - see persona/config.py's own
# field comments for what each one controls.
PERSONA_DECAY_LAMBDA=0.03
PERSONA_CLUSTER_SIMILARITY_THRESHOLD=0.4
PERSONA_EPISODE_GAP_HOURS=168.0
PERSONA_MIN_SESSIONS_PER_TRANSITION=2
PERSONA_CONTEXT_CONFIDENCE_FLOOR=0.15

# --- Observability / dev-only / admin access ---------------------------------
# Read directly by the Langfuse SDK (not through our Settings) - unset just
# gives a disabled no-op tracing client, never a startup failure.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Dev-only: include synthesis reasoning in the ai_mode_done websocket message.
EXPOSE_REASONING=false
# Gates the /admin UI (eval runner + flags) entirely - unset disables it.
ADMIN_SECRET=

# --- Offline tooling only: not read by the retrieval-api service process ----
# packages/common/scripts/export_hot_search_queries.py and
# build_instant_classifier_dataset.py (TaxmannDW warehouse export)
DB_IP=
DB_PORT=3306
DB_USER=
DB_NAME=
DB_PASSWORD=
DEEPINFRA_ML_CLASSIFIER_MODEL=google/gemma-4-26B-A4B-it
# evals/hot_query_smoke_test.py only - live prod API auth (never commit real values)
PROD_API_TOKEN=
PROD_MACHINE_ID=
