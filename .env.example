# =============================================================================
# REQUIRED - the service will not start (pydantic-settings validation fails)
# without every one of these set. This includes the LOCAL_* self-hosted
# chat/rerank fields even if you never set CHAT_PROVIDER/RERANK_PROVIDER to
# use them - they have no code default, so pydantic still demands a value.
# =============================================================================

# Milvus
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=root:Milvus

# Elasticsearch
ES_URI=http://localhost:9200

# model-gateway: DeepInfra + Voyage credentials/models
DEEPINFRA_API_KEY=
DEEPINFRA_CHAT_MODEL_SLM=google/gemma-4-26B-A4B-it
DEEPINFRA_CHAT_MODEL_SYNTHESIS=meta-llama/Meta-Llama-3.1-70B-Instruct
DEEPINFRA_RERANK_MODEL=Qwen/Qwen3-Reranker-0.6B
VOYAGE_API_KEY=
VOYAGE_EMBED_MODEL=voyage-4-large

# model-gateway: self-hosted chat endpoint fields (required even when unused -
# see note above; only actually called when CHAT_PROVIDER=local)
LOCAL_API_KEY=unsecure-api-key-taxmann
LOCAL_BASE_URL=http://192.168.0.15:8000/v1
LOCAL_CHAT_MODEL_SLM=qwen3
LOCAL_CHAT_MODEL_SYNTHESIS=qwen3

# auth + persona + chat + semantic_cache (shared Mongo deployment)
MONGO_URI=mongodb://host.docker.internal:27017
MONGO_DB=taxmann_auth
JWT_SECRET=  # generate with: openssl rand -hex 32
JWT_EXPIRY_MINUTES=60

# =============================================================================
# OPTIONAL - every var below has a code default and the service runs fine
# without it. The toggles in this first block are also editable at runtime
# from /admin -> Flags (Mongo override, no redeploy) once the service is up -
# what you set here only matters as the *initial*/local-dev value, and an env
# var set here always wins over a Mongo override (see feature_flags.py).
# =============================================================================

# Mongo-overridable feature flags (common.config.Settings /
# model_gateway.config.GatewaySettings / semantic_cache.config.SemanticCacheSettings)
AI_MODE_RERANK_ENABLED=true
INSTANT_MODE_AUTO_ROUTE_ENABLED=true
INSTANT_MODE_RERANK_ENABLED=false
INSTANT_MODE_RRF_ENABLED=true
MILVUS_SPARSE_ENABLED=false
KEYWORD_MODE_EXPANSION_ENABLED=false
SLM_REASONING_ENABLED=true
SYNTHESIS_REASONING_ENABLED=true
SEMANTIC_CACHE_ENABLED=true
EXPOSE_REASONING=false  # dev-only: include synthesis reasoning in the ai_mode_done websocket message

# Milvus / Elasticsearch tuning
MILVUS_DB=aic
ES_USERNAME=
ES_PASSWORD=
ES_INDEX=taxmann_caselaw
ES_VERIFY_CERTS=true

# model-gateway: provider switches
CHAT_PROVIDER=deepinfra  # deepinfra | local
RERANK_PROVIDER=deepinfra  # deepinfra | local_rerank

# model-gateway: self-hosted reranker (only read when RERANK_PROVIDER=local_rerank)
LOCAL_RERANK_BASE_URL=http://192.168.0.15:8001/v1
LOCAL_RERANK_MODEL=qwen3-reranker

# Langfuse (tracing - unset disables it, doesn't fail startup)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# auth
REFRESH_TOKEN_EXPIRY_DAYS=7

# semantic_cache
SEMANTIC_CACHE_THRESHOLD=0.95

# admin UI (/admin - eval runner + flags) - unset disables it entirely
ADMIN_SECRET=

# Offline tooling only - not read by the retrieval-api service itself.
# packages/common/scripts/export_hot_search_queries.py and
# build_instant_classifier_dataset.py (TaxmannDW warehouse export)
DB_IP=
DB_PORT=3306
DB_USER=
DB_NAME=
DB_PASSWORD=
DEEPINFRA_ML_CLASSIFIER_MODEL=google/gemma-4-26B-A4B-it

# evals/hot_query_smoke_test.py only - live prod API auth (never commit real values)
PROD_API_TOKEN=
PROD_MACHINE_ID=
