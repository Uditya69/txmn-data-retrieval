# Milvus
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=root:Milvus
MILVUS_DB=aic

# Elasticsearch
ES_URI=http://localhost:9200
ES_USERNAME=
ES_PASSWORD=
ES_INDEX=taxmann_caselaw
ES_VERIFY_CERTS=true

# AI Mode retrieval
# Kill switch for intent-driven RRF dense/sparse weighting (retrieve.py's
# _INTENT_RRF_WEIGHTS). Set to false to force neutral (1.0, 1.0) weighting
# regardless of classified intent.
INTENT_RRF_WEIGHTING_ENABLED=true

# model-gateway
GATEWAY_URL=http://model-gateway:8001
DEEPINFRA_API_KEY=
# DEEPINFRA_CHAT_MODEL_SLM=meta-llama/Meta-Llama-3.1-8B-Instruct  # pre-small-model-eval default
# DEEPINFRA_CHAT_MODEL_SLM=Qwen/Qwen3-30B-A3B  # superseded by gemma-4-26B-A4B-it below
# NOTE: this role's model MUST support DeepInfra's response_format: {"type": "json_object"}
# mode (intent.py sends it unconditionally, with no fallback). google/gemma-4-E4B-it was
# evaluated and rejected: DeepInfra returns HTTP 405 for it. See docs/small-model-eval-results.md.
# NOTE: DeepInfra silently substitutes a different model with no error when a requested
# model name is deprecated/retired (confirmed for meta-llama/Llama-3.2-3B-Instruct ->
# google/gemma-4-31B-it) - always verify a model name still echoes itself back in the
# response's "model" field before trusting an eval result against it.
DEEPINFRA_CHAT_MODEL_SLM=google/gemma-4-26B-A4B-it  # confirmed via evals/intent_filter_cases.json prompt-only check: 9/12 vs Qwen3-30B-A3B baseline's 5-8/12 (run-to-run variance observed) - correctly extracts bench, which the baseline never did
DEEPINFRA_CHAT_MODEL_SYNTHESIS=meta-llama/Meta-Llama-3.1-70B-Instruct  # no confirmed self-hostable replacement yet - see docs/small-model-eval-results.md
DEEPINFRA_CHAT_MODEL_AGENT=Qwen/Qwen3-235B-A22B
# DEEPINFRA_RERANK_MODEL=Qwen/Qwen3-Reranker-4B  # pre-small-model-eval default
DEEPINFRA_RERANK_MODEL=Qwen/Qwen3-Reranker-0.6B  # confirmed via docs/small-model-eval-results.md: mild dip, one query (Q47) worth a spot-check
VOYAGE_API_KEY=
VOYAGE_EMBED_MODEL=voyage-4-large

# Langfuse
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
