# Real backend pagination (page/page_size) for Instant mode. Off by default - when off,
# InstantPane keeps its existing client-side 10-per-page slice over a flat 20-result fetch.
# No UI checkbox for this, deliberately - purely a build-time flag. See App.tsx's
# PAGINATION_ENABLED and useSearch's optional page/pageSize params.
VITE_ENABLE_PAGINATION=false
